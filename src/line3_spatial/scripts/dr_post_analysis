#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# dr_post_analysis：line3_spatial 虚拟敲除后线内分析（aims 线3 第 155 行两项收尾）。
#   1. DR 基因富集（prerank GSEA，全 DR 表按 Z 排序，不依赖显著阈值；小鼠/人源分库）
#   2. DR ∩ 空间域 marker 交集
#
# 输入（cwd 下）：
#   spatial_knockout_mouse.h5ad / spatial_knockout_human.h5ad（步骤 13：uns['knockout']）
#   ko_dr_genes_mouse.tsv / ko_dr_genes_human.tsv（步骤 13 DR 全表）
#   domain_markers_mouse.tsv / domain_markers_human.tsv（步骤 6 域 marker）
#   ../references/gmt_cache/*.gmt（Enrichr 基因集缓存，按物种取用）
# 输出（cwd 下）：
#   dr_enrichment_{mouse,human}.tsv / dr_overlap_{mouse,human}.tsv / dr_post_report.txt
#   ../figures/l3_{mouse,human}_10_dr_gsea_top.png / l3_{mouse,human}_11_dr_overlap.png
#
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；DR 不是 DEG；富集条形双标注；
#       图注置坐标轴框外；小鼠/人源基因集分物种，不混用）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

echo "step_executed=dr_post_analysis"
echo "bioanalys_seed=${seed}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import hashlib
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
import numpy as np
import pandas as pd
import anndata as ad
import gseapy

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
ALPHA = 0.05
# BIO_GMT_CACHE 可覆盖 gmt 缓存目录（默认 <cwd>/../references/gmt_cache，见 SPEC_DECISIONS D-22）
CACHE = os.environ.get("BIO_GMT_CACHE", os.path.join("..", "references", "gmt_cache"))
os.makedirs(CACHE, exist_ok=True)
UP = "#D62728"
DOWN = "#1F77B4"

# 物种 -> (Enrichr 库名, organism)
SPECIES_LIBS = {
    "mouse": [("KEGG_2019_Mouse", "mouse"), ("WikiPathways_2019_Mouse", "mouse")],
    "human": [("KEGG_2021_Human", "human"), ("GO_Biological_Process_2023", "human"),
              ("Reactome_Pathways_2024", "human")],
}


def fail(m):
    sys.stderr.write("dr_post_analysis 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    不再按图幅横竖分支把图例放到轴框下方。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


def load_lib(name, organism):
    """取基因集：优先本地 gmt 缓存，缺失则联网下载并缓存（离线可复用）。"""
    path = os.path.join(CACHE, "%s.gmt" % name)
    if os.path.exists(path):
        try:
            return gseapy.read_gmt(path)
        except Exception:
            pass
    try:
        gs = gseapy.get_library(name=name, organism=organism)
        with open(path, "w", encoding="utf-8") as fh:
            for term, genes in gs.items():
                fh.write("%s\tna\t%s\n" % (term, "\t".join(genes)))
        return gs
    except Exception as e:
        log("  gene set %s 不可用：%s（跳过）" % (name, str(e)[:80]))
        return None


report_lines = [
    "step=dr_post_analysis",
    "seed=%d" % SEED,
    "DR_NOTE=DR genes are not DEG; DR from computational network perturbation, not experiment",
    "",
]

# 物种集合由实际存在的 knock-out 产物推导（GSE233814 只有小鼠）。
# 缺席物种是「本数据集没有该物种」，不是「缺文件」；已识别物种若缺产物仍 fail。
SPECIES_CANDIDATES = ["mouse", "human"]
species_present = []
for sp in SPECIES_CANDIDATES:
    if os.path.exists("spatial_knockout_%s.h5ad" % sp):
        species_present.append(sp)
if not species_present:
    fail("spatial_knockout_{mouse,human}.h5ad 全部缺席（步骤 13 产物未生成？）")
log("species_present=%s" % ",".join(species_present))

for species in species_present:
    h5ad = "spatial_knockout_%s.h5ad" % species
    dr_tsv = "ko_dr_genes_%s.tsv" % species
    mk_tsv = "domain_markers_%s.tsv" % species
    for f in [h5ad, dr_tsv, mk_tsv]:
        if not os.path.exists(f):
            fail("缺少输入 %s" % f)

    a = ad.read_h5ad(h5ad)
    ko = a.uns.get("knockout")
    if not isinstance(ko, dict):
        fail("%s 缺 uns['knockout']" % h5ad)
    ko_gene = str(ko.get("ko_gene", ""))
    n_sig_uns = int(ko.get("n_significant_dr", 0))
    log("=== %s ko_gene=%s n_sig_dr=%d ===" % (species, ko_gene, n_sig_uns))

    dr = pd.read_csv(dr_tsv, sep="\t")
    for col in ["Gene", "Z", "adjusted p-value", "is_knockout_gene", "sample_id"]:
        if col not in dr.columns:
            fail("%s 缺列 %s" % (dr_tsv, col))
    dr["Z"] = pd.to_numeric(dr["Z"], errors="coerce")
    dr["adjusted p-value"] = pd.to_numeric(dr["adjusted p-value"], errors="coerce")
    dr_nonko = dr[~dr["is_knockout_gene"].astype(bool)].dropna(subset=["Z"])

    # 物种级 DR 汇总：每基因 min(adj p) + mean(Z) + 显著样本数
    agg = dr_nonko.groupby("Gene").agg(
        mean_z=("Z", "mean"),
        min_adj_p=("adjusted p-value", "min"),
        n_sig_samples=("adjusted p-value", lambda s: int((s < ALPHA).sum())),
    ).reset_index()
    agg = agg.sort_values("mean_z", ascending=False)
    if len(agg) < 20:
        fail("%s 非敲除 DR 基因 < 20，GSEA 不可靠" % species)
    sig_dr = set(agg.loc[agg["min_adj_p"] < ALPHA, "Gene"].astype(str))

    # --- 1. DR 富集（prerank GSEA） ---
    libs = {}
    for name, org in SPECIES_LIBS[species]:
        gs = load_lib(name, org)
        if gs:
            libs[name] = gs
    if not libs:
        fail("%s 无可用基因集" % species)

    rnk = agg.set_index("Gene")["mean_z"]
    rnk = rnk[~rnk.index.duplicated(keep="first")]
    rows = []
    for lib, gs in libs.items():
        try:
            res = gseapy.prerank(rnk=rnk, gene_sets=gs, min_size=5, max_size=500,
                                 permutation_num=1000, seed=SEED, outdir=None,
                                 verbose=False)
            df = res.res2d
            if df is None or not len(df):
                continue
            df = df.copy()
            df["library"] = lib
            rows.append(df)
        except Exception as e:
            log("  [%s/%s] GSEA 失败：%s" % (species, lib, str(e)[:80]))
    if not rows:
        fail("%s DR GSEA 无结果" % species)
    gsea = pd.concat(rows, ignore_index=True)
    keep = [c for c in ["library", "Term", "ES", "NES", "NOM p-val", "FDR q-val",
                        "Lead_genes"] if c in gsea.columns]
    gsea = gsea[keep]
    gsea["NES"] = pd.to_numeric(gsea["NES"], errors="coerce")
    gsea["FDR q-val"] = pd.to_numeric(gsea["FDR q-val"], errors="coerce")
    gsea = gsea.dropna(subset=["NES", "FDR q-val"])
    if not np.all(np.isfinite(gsea["NES"])):
        fail("%s GSEA NES 含非有限值" % species)
    gsea = gsea.sort_values(["FDR q-val", "NES"], ascending=[True, False])
    gsea.to_csv("dr_enrichment_%s.tsv" % species, sep="\t", index=False)
    log("wrote dr_enrichment_%s.tsv (%d 行, %d 库)" % (species, len(gsea), len(libs)))

    # 图：top20 by FDR
    TOP_N = 20
    d = gsea.copy()
    d["absnes"] = d["NES"].abs()
    d = d.sort_values(["FDR q-val", "absnes"], ascending=[True, False]).head(TOP_N).iloc[::-1]
    y = np.arange(len(d))
    nes = d["NES"].to_numpy()
    labels = ["%s | %s" % (lib, (t if len(str(t)) <= 46 else str(t)[:43] + "..."))
              for lib, t in zip(d["library"], d["Term"])]
    plt.rcParams["figure.autolayout"] = False
    fig, ax = plt.subplots(figsize=(12, max(6, len(d) * 0.40)))
    ax.barh(y, nes, color=[UP if v > 0 else DOWN for v in nes], height=0.7)
    ax.set_yticks(y)
    ax.set_yticklabels(labels, fontsize=8)
    ax.axvline(0, color="k", lw=0.6)
    ax.set_xlabel("NES (normalized enrichment score)")
    span = max(float(np.abs(nes).max()), 1e-9) * 2.4
    ax.set_xlim(-span, span)
    for i, (v, q) in enumerate(zip(nes, d["FDR q-val"].to_numpy())):
        ax.text(v + (0.04 * span if v >= 0 else -0.04 * span), i,
                "NES=%.2f  FDR q=%.2g" % (v, q),
                va="center", ha="left" if v >= 0 else "right", fontsize=8)
    # 图例外置到轴框右侧（figure_spec v2.2 禁止轴内 loc="best"）
    ax.legend(handles=[Patch(color=UP, label="activated (NES>0)"),
                       Patch(color=DOWN, label="inhibited (NES<0)")],
              fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
              ncol=1, frameon=False)
    caption(fig, "[Virtual KO - DR Genes] line3 %s: DR gene GSEA (KO %s) top-%d by FDR" % (species, ko_gene, len(d)),
            "ko_dr_genes_%s.tsv ranked by mean tenifold Z (not DEG)" % species,
            "bar = NES, label = NES + FDR q-val")
    fig.subplots_adjust(left=0.46, right=0.82, top=0.97, bottom=0.09)
    fig.savefig(os.path.join("..", "figures", "l3_%s_10_dr_gsea_top.png" % species))
    plt.close(fig)
    plt.rcParams["figure.autolayout"] = True

    # --- 2. DR ∩ 空间域 marker 交集 ---
    mk = pd.read_csv(mk_tsv, sep="\t")
    if "gene_symbol" not in mk.columns or "group" not in mk.columns:
        fail("%s 缺 gene_symbol 或 group 列" % mk_tsv)
    marker_to_domain = {}
    for _, r in mk.iterrows():
        marker_to_domain.setdefault(str(r["gene_symbol"]), []).append(str(r["group"]))
    marker_genes = set(marker_to_domain)

    dr_all = set(agg["Gene"].astype(str))
    universe = sorted(sig_dr | marker_genes)
    ov_rows = []
    for g in universe:
        ov_rows.append({
            "gene": g,
            "in_DR_significant": g in sig_dr,
            "in_DR_any": g in dr_all,
            "in_domain_marker": g in marker_to_domain,
            "marker_domains": ";".join(sorted(marker_to_domain.get(g, []))[:6]),
        })
    overlap = pd.DataFrame(ov_rows)
    overlap["n_sources"] = (overlap[["in_DR_significant", "in_domain_marker"]].sum(axis=1))
    overlap = overlap.sort_values(["n_sources", "gene"], ascending=[False, True])
    overlap.to_csv("dr_overlap_%s.tsv" % species, sep="\t", index=False)
    log("wrote dr_overlap_%s.tsv (%d 基因)" % (species, len(overlap)))

    sets_def = [
        ("DR_sig", sig_dr),
        ("domain_marker", marker_genes),
        ("DR_sig∩marker", sig_dr & marker_genes),
    ]
    names = [s[0] for s in sets_def]
    vals = [len(s[1]) for s in sets_def]
    plt.rcParams["figure.autolayout"] = False
    fig, ax = plt.subplots(figsize=(7, 5))
    ax.bar(range(len(names)), vals, color=["#C44E52", "#4C72B0", "#DD8452"])
    ax.set_xticks(range(len(names)))
    ax.set_xticklabels(names, rotation=20, ha="right", fontsize=8)
    ax.set_ylabel("gene count")
    xmax = max(vals) if max(vals) > 0 else 1
    ax.set_ylim(0, xmax * 1.22)
    for i, v in enumerate(vals):
        ax.text(i, v + xmax * 0.02, str(v), ha="center", va="bottom", fontsize=8)
    caption(fig, "[Virtual KO - DR Genes] line3 %s: DR / spatial domain-marker overlap (KO %s)" % (species, ko_gene),
            "DR significant = adj p<%.2f & non-KO; marker = step6 domain_markers" % ALPHA)
    fig.subplots_adjust(left=0.12, right=0.82, top=0.95, bottom=0.20)
    fig.savefig(os.path.join("..", "figures", "l3_%s_11_dr_overlap.png" % species))
    plt.close(fig)
    plt.rcParams["figure.autolayout"] = True

    report_lines += [
        "=== %s ===" % species,
        "ko_gene=%s" % ko_gene,
        "n_dr_genes_total=%d  n_dr_significant_nonko=%d" % (len(agg), len(sig_dr)),
        "libraries=%s" % ",".join(sorted(libs.keys())),
        "n_gsea_terms=%d" % len(gsea),
        "domain_markers=%d  DR_sig∩marker=%d" % (len(marker_genes), len(sig_dr & marker_genes)),
        "top GSEA by FDR:",
    ]
    for _, r in gsea.head(6).iterrows():
        report_lines.append("  %-42s NES=%.2f FDR q=%.2g"
                            % (str(r["Term"])[:42], r["NES"], r["FDR q-val"]))
    inter = sorted(sig_dr & marker_genes)
    if inter:
        report_lines.append("DR∩marker genes: %s" % ",".join(inter[:20]))
    report_lines.append("")

report_lines += [
    "limitations:",
    "  1. DR 富集用全表 prerank GSEA（人源显著 DR 仅少量，ORA 不可靠），与 line1 DEG 0 显著时做法一致。",
    "  2. 小鼠用 Enrichr 小鼠库（KEGG_2019_Mouse / WikiPathways_2019_Mouse），"
    "人源用 KEGG/GO_BP/Reactome；分物种取库不混用。",
    "  3. DR 是调控变化不是表达变化，与域 marker 交集只作交叉印证。",
    "",
    "elapsed_seconds=%.1f" % (time.time() - START),
    "outputs=dr_enrichment_mouse.tsv, dr_enrichment_human.tsv, dr_overlap_mouse.tsv, dr_overlap_human.tsv, ../figures/l3_mouse_10_dr_gsea_top.png, ../figures/l3_mouse_11_dr_overlap.png, ../figures/l3_human_10_dr_gsea_top.png, ../figures/l3_human_11_dr_overlap.png, dr_post_report.txt",
]
with open("dr_post_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(report_lines) + "\n")

for _artifact in sorted(os.listdir(".")):
    if not os.path.isfile(_artifact):
        continue
    if _artifact == 'dr_post_report.txt':
        continue
    with open(_artifact, "rb") as _fh:
        _digest = hashlib.sha256(_fh.read()).hexdigest()
    with open('dr_post_report.txt', "a", encoding="utf-8") as _fh:
        _fh.write("%s_sha256=%s\n" % (_artifact, _digest))
log("dr_post_analysis_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD" "dr_post_report.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi
