#!/usr/bin/env bash
# enrichment_figures：line3_spatial 富集结果出图（读 enrichment 步骤产物 tsv，产 PNG 供目视审核）。
#
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
#   参考库仅用于风格与手法借鉴，不构成代码派生关系。
# 输入（cwd 下，缺哪个跳哪张图）：
#   enrichment_ora_mouse.tsv / enrichment_ora_human.tsv（逐域 ORA 全表）
#   enrichment_gsea_mouse.tsv / enrichment_gsea_human.tsv（逐域 prerank GSEA）
# 输出：写到 ../figures/（独立出图目录，不混进 processed/）
#   l3_mouse_12_ora_top.png / l3_mouse_13_gsea_top.png
#   l3_human_12_ora_top.png / l3_human_13_gsea_top.png
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；富集条形按显著性排序，
#       NES/富集比 + 校正 p 双标注；图注置于坐标轴框外；图例不压数据；域数 > 20 扩 60 色板）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

workdir=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  if [ -d "$path" ]; then
    workdir="$path"
  elif [ -f "$path" ]; then
    workdir="$(dirname "$path")"
  fi
done
workdir="${workdir:-$(pwd)}"

echo "step_executed=enrichment_figures"
echo "bioanalys_seed=${seed}"
echo "workdir=${workdir}"

FIG_DIR="$workdir"
export FIG_DIR

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
import numpy as np
import pandas as pd

plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
D = os.environ["FIG_DIR"]
OUT = os.path.join(D, "..", "figures")
os.makedirs(OUT, exist_ok=True)
made = []
render_ms = []   # 逐图渲染耗时 (name, ms)，写进 figures_manifest 供超时审计

UP = "#D62728"      # NES > 0（激活）
DOWN = "#1F77B4"    # NES < 0（抑制）


def fail(m):
    """自校验失败：stderr 写明原因并以非零退出（与其他母版同口径，缺它会 NameError 崩栈）。"""
    sys.stderr.write("enrichment_figures 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def save(fig, name):
    # 逐图计时（Argon 第 65 轮 Q3/Q4）：单图 30s 设计目标 / 60s 硬上限。
    # 计时进 manifest，超时从「不可见」变成「回执可查」，不必为查超时连 K40 真跑。
    _t0 = time.perf_counter()
    fig.savefig(os.path.join(OUT, name))
    plt.close(fig)
    _ms = (time.perf_counter() - _t0) * 1000.0
    made.append(name)
    render_ms.append((name, _ms))
    log("wrote %s render_ms=%.1f" % (name, _ms))


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    不再按图幅横竖分支把图例放到轴框下方。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


def rd(name):
    p = os.path.join(D, name)
    return pd.read_csv(p, sep="\t") if os.path.exists(p) else None


def trunc(text, width=48):
    """term 描述可能很长，截断保证 y 轴标签不越界（英文省略号，不用中文标点）。"""
    text = str(text)
    return text if len(text) <= width else text[:width - 3] + "..."


def num(series):
    return pd.to_numeric(series, errors="coerce")


def cat_colors(labels):
    """确定性分类配色：tab20+tab20b+tab20c 拼 60 色（域数可能超 20）。"""
    cats = sorted(set(labels))
        # Okabe-Ito 八色打底（色盲友好、灰度可辨）；类别数超过 8 时用 Paired 平滑扩充并去重
    _OKABE = ["#E69F00", "#56B4E9", "#009E73", "#F0E442",
              "#0072B2", "#D55E00", "#CC79A7", "#000000"]
    _seen = set()
    palette = []
    for _c in (_OKABE
               + [matplotlib.colors.to_hex(x) for x in plt.get_cmap("Paired").colors]
               + [matplotlib.colors.to_hex(x) for x in plt.get_cmap("tab20b").colors]):
        if _c not in _seen:
            _seen.add(_c)
            palette.append(_c)
    return {c: palette[i % len(palette)] for i, c in enumerate(cats)}, cats


TOP_N = 20

# 物种集合由实际存在的 enrichment 产物推导（GSE233814 只有小鼠）。
# 本步骤原已对缺席物种容错（rd() 返回 None 时跳过），但循环仍写死两物种；
# 改为按产物在位推导，语义保持「缺席即跳过」，不改成报错。
SPECIES_CANDIDATES = ["mouse", "human"]
species_present = []
for sp in SPECIES_CANDIDATES:
    if os.path.exists("enrichment_ora_%s.tsv" % sp) or os.path.exists("enrichment_gsea_%s.tsv" % sp):
        species_present.append(sp)
if not species_present:
    fail("enrichment_{ora,gsea}_{mouse,human}.tsv 全部缺席（步骤 14 产物未生成？）")
log("species_present=%s" % ",".join(species_present))

for species in species_present:
    # --- 12 ORA：按校正 p 排序，条形 = -log10(adj p)，按域分色，双标注 OR + adj p ---
    ora = rd("enrichment_ora_%s.tsv" % species)
    if ora is not None and len(ora) and {"domain", "Term", "Adjusted P-value"} <= set(ora.columns):
        d = ora.copy()
        d["adj"] = num(d["Adjusted P-value"])
        d["or"] = num(d["Odds Ratio"]) if "Odds Ratio" in d.columns else np.nan
        d = d.dropna(subset=["adj", "Term"])
        d = d.sort_values("adj").head(TOP_N).iloc[::-1]
        y = np.arange(len(d))
        score = -np.log10(np.clip(d["adj"].to_numpy(), 1e-300, 1))
        doms = d["domain"].astype(str).to_numpy()
        cmap, uniq = cat_colors(doms)
        labels = ["%s | %s" % (dm, trunc(t, 44)) for dm, t in zip(doms, d["Term"])]
        plt.rcParams["figure.autolayout"] = False
        fig, ax = plt.subplots(figsize=(13, max(6, len(d) * 0.42)))
        ax.barh(y, score, color=[cmap[c] for c in doms], height=0.7)
        ax.set_yticks(y)
        ax.set_yticklabels(labels, fontsize=8)
        ax.set_xlabel("-log10 adjusted p")
        xmax = max(float(score.max()), 1e-9) * 2.0
        ax.set_xlim(0, xmax)
        for i, (v, p, o) in enumerate(zip(score, d["adj"].to_numpy(), d["or"].to_numpy())):
            label = ("OR=%.2f  adj p=%.2g" % (o, p)) if np.isfinite(o) else ("adj p=%.2g" % p)
            ax.text(v + 0.02 * xmax, i, label, va="center", ha="left", fontsize=8)
        if 1 < len(uniq) <= 20:
            # 图例外置到轴框右侧（figure_spec v2.2：禁止轴内 loc）
            ax.legend(handles=[Patch(color=cmap[c], label=c) for c in uniq],
                      fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                      ncol=min(len(uniq), 4), frameon=False, title="domain")
        cap_parts = [
            "line3 %s: spatial domain marker ORA top-%d by adjusted p" % (species, len(d)),
            "enrichment_ora_%s.tsv from step: enrichment" % species,
            "bar = -log10 adj p, label = odds ratio + adj p",
        ]
        if len(uniq) > 1:
            cap_parts.append("color = domain")
            if len(uniq) > 20:
                # 域过多时图例会喧宾夺主，改为图注说明配色仅区分域、不逐一列举
                cap_parts.append("%d domains colored, labels in enrichment_ora_%s.tsv"
                                 % (len(uniq), species))
        caption(fig, *cap_parts)
        fig.subplots_adjust(left=0.46, right=0.82, top=0.97, bottom=0.09)
        save(fig, "l3_%s_12_ora_top.png" % species)
        plt.rcParams["figure.autolayout"] = True

    # --- 13 GSEA：按 FDR q 排序（同值按 |NES| 降序），条形 = NES，双标注 NES + FDR q ---
    gse = rd("enrichment_gsea_%s.tsv" % species)
    if gse is not None and len(gse) and {"domain", "Term", "NES", "FDR q-val"} <= set(gse.columns):
        d = gse.copy()
        d["NES"] = num(d["NES"])
        d["fdr"] = num(d["FDR q-val"])
        d = d.dropna(subset=["NES", "fdr", "Term"])
        d["absnes"] = d["NES"].abs()
        d = d.sort_values(["fdr", "absnes"], ascending=[True, False]).head(TOP_N).iloc[::-1]
        y = np.arange(len(d))
        nes = d["NES"].to_numpy()
        colors = [UP if v > 0 else DOWN for v in nes]
        labels = ["%s | %s" % (dm, trunc(t, 44))
                  for dm, t in zip(d["domain"].astype(str), d["Term"])]
        plt.rcParams["figure.autolayout"] = False
        fig, ax = plt.subplots(figsize=(13, max(6, len(d) * 0.42)))
        ax.barh(y, nes, color=colors, height=0.7)
        ax.set_yticks(y)
        ax.set_yticklabels(labels, fontsize=8)
        ax.axvline(0, color="k", lw=0.6)
        ax.set_xlabel("NES (normalized enrichment score)")
        span = max(float(np.abs(nes).max()), 1e-9) * 2.4
        ax.set_xlim(-span, span)
        for i, (v, q) in enumerate(zip(nes, d["fdr"].to_numpy())):
            ax.text(v + (0.04 * span if v >= 0 else -0.04 * span), i,
                    "NES=%.2f  FDR q=%.2g" % (v, q),
                    va="center", ha="left" if v >= 0 else "right", fontsize=8)
        # 图例外置到轴框右侧（figure_spec v2.2 禁止轴内 loc="best"）
        ax.legend(handles=[Patch(color=UP, label="activated (NES>0)"),
                           Patch(color=DOWN, label="inhibited (NES<0)")],
                  fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
                  ncol=1, frameon=False)
        caption(fig, "line3 %s: spatial domain marker GSEA top-%d by FDR q-val" % (species, len(d)),
                "enrichment_gsea_%s.tsv from step: enrichment" % species,
                "bar = NES, label = NES + FDR q-val")
        fig.subplots_adjust(left=0.46, right=0.82, top=0.97, bottom=0.09)
        save(fig, "l3_%s_13_gsea_top.png" % species)
        plt.rcParams["figure.autolayout"] = True

# 输入数据溯源（Argon 第 65 轮 B4）：只记产物清单时，「这张图由哪份数据渲染」不可证。
# 大文件分级：超 500MB 全量读哈希会把 K40 的 I/O 拖死，改为 size + 首尾各 1MB 采样。
LARGE_FILE_BYTES = 500 * 1024 * 1024
SAMPLE_WINDOW = 1024 * 1024


def _sha256_of(p):
    """常规文件全量 sha256；超大文件退回 size + 首尾各 1MB 指纹。"""
    import hashlib
    size = os.path.getsize(p)
    h = hashlib.sha256()
    if size <= LARGE_FILE_BYTES:
        with open(p, "rb") as fh:
            for chunk in iter(lambda: fh.read(SAMPLE_WINDOW), b""):
                h.update(chunk)
        return "full:" + h.hexdigest()
    h.update(("size=%d;" % size).encode("utf-8"))
    with open(p, "rb") as fh:
        h.update(fh.read(SAMPLE_WINDOW))
        if size > 2 * SAMPLE_WINDOW:
            fh.seek(-SAMPLE_WINDOW, os.SEEK_END)
            h.update(fh.read(SAMPLE_WINDOW))
    return "sampled:" + h.hexdigest()


def input_fingerprints(paths):
    """把本步读取的输入文件算成指纹，键按文件名稳定排序。"""
    rows = []
    for p in sorted(x for x in paths if x and os.path.isfile(x)):
        try:
            rows.append((os.path.basename(p), _sha256_of(p)))
        except OSError as exc:
            rows.append((os.path.basename(p), "unreadable:" + type(exc).__name__))
    return rows



log("figures_done count=%d out=%s elapsed=%.1fs"
    % (len(made), OUT, time.time() - START))

# 产物清单落盘：只打 stdout 的话，任务重跑与事后核对时清单就沦了。
# 写一份 manifest 到 figures/，让“exit 0 但产物落别处”可核对。
try:
    _man = os.path.join(OUT, "figures_manifest.txt")
    with open(_man, "w", encoding="utf-8") as _fh:
        _fh.write("step=%s seed=%s out=%s count=%d elapsed=%.1fs%s" % (
            os.path.basename(sys.argv[0]),
            os.environ.get("BIOANALYS_SEED", "UNSET"),
            OUT, len(made), time.time() - START, chr(10)))
        for _rn, _rms in render_ms:
            _fh.write("render_ms=%s=%.1f%s" % (_rn, _rms, chr(10)))
        for _name, _digest in input_fingerprints([os.path.join(D, "enrichment_ora_%s.tsv" % sp) for sp in species_present] + [os.path.join(D, "enrichment_gsea_%s.tsv" % sp) for sp in species_present]):
            _fh.write("input_sha256=%s=%s%s" % (_name, _digest, chr(10)))
        for _n in made:
            _p = os.path.join(OUT, _n)
            _sz = os.path.getsize(_p) if os.path.exists(_p) else -1
            _fh.write("%s%s%d%s" % (_n, chr(9), _sz, chr(10)))
    log("wrote figures_manifest.txt (%d entries)" % len(made))
except OSError as _exc:
    log("WARN 产物清单落盘失败: %s" % _exc)

# 规范要求的 *_report.txt：manifest 是给人核对的产物清单，report 是给台账
# 与下游消费的步骤摘要，两者分工不同，都要落。
try:
    _rep = os.path.join(OUT, "enrichment_figures_report.txt")
    with open(_rep, "w", encoding="utf-8") as _fh:
        _fh.write("step=%s\n" % os.path.basename(sys.argv[0]))
        _fh.write("seed=%s\n" % os.environ.get("BIOANALYS_SEED", "UNSET"))
        _fh.write("out=%s\n" % OUT)
        _fh.write("figure_count=%d\n" % len(made))
        _fh.write("elapsed_seconds=%.1f\n" % (time.time() - START))
        _fh.write("outputs=%s\n" % ", ".join(["figures_manifest.txt"] + list(made)))
    log("wrote enrichment_figures_report.txt")
except OSError as _exc:
    log("WARN 步骤报告落盘失败: %s" % _exc)
    # 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
    # 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
    plt.close("all")
PYSCRIPT

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD/../figures" "enrichment_figures_report.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi
